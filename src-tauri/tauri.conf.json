{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NewPi",
  "version": "0.1.0",
  "identifier": "io.newpi.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "NewPi",
        "url": "index.html",
        "width": 1360,
        "height": 900,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "NewPi, a native desktop application for macOS",
    "longDescription": "NewPi runs its engine locally and shows the interface in a native macOS window. Nothing is sent to a remote server beyond the model traffic NewPi itself performs.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
